// Single database schema for the whole project.
//
// Rules to avoid merge conflicts:
//   - Each person only edits the models inside their own section.
//   - Changes to the CORE section are discussed with the whole team first.
//   - After editing, run `make db` to push the schema and regenerate the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE (shared by everyone – agreed together on day 1)
//   User, Workspace, WorkspaceMember
// ============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  displayName     String
  avatarUrl       String?
  /// scrypt hash; null for accounts created with Google / GitHub / 42 only.
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  oauthAccounts   OAuthAccount[]
  authTokens      AuthToken[]
  twoFactor       TwoFactor?
  membership      WorkspaceMember?
  invitationsSent Invitation[]
  settings        UserSettings?
  chatMessages    ChatMessage[]
  bookings        RoomBooking[]
}

/// An organisation and its virtual office. Created by its owner (the organiser).
model Workspace {
  id            String   @id @default(cuid())
  name          String
  /// Template the office started from (studio, loft, campus...).
  templateId    String
  /// The office: rooms, walls, furniture (see apps/api/src/office/layout/types.ts).
  layout        Json
  /// Bumped on every save, so two editors can't overwrite each other.
  layoutVersion Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members      WorkspaceMember[]
  invitations  Invitation[]
  chatMessages ChatMessage[]
  bookings     RoomBooking[]
}

/// OWNER: the organiser (one per workspace). ADMIN: can invite and edit the office.
enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// A person in a workspace. One workspace per user (userId is unique).
model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String   @unique
  workspaceId String
  role        Role     @default(MEMBER)
  /// Character: a named preset ("maya", "sam"...) or a recipe code: "1" + one
  /// base-36 digit per choice (body, hair, outfit, desk vibe...), 19 characters.
  /// Format and validation: apps/web/game/art/recipe.ts, apps/api/src/workspace/characters.ts.
  character   String   @default("maya")
  /// Their desk: a desk furniture id of the layout (null when every desk is taken).
  deskId      String?
  /// Short status shown above the avatar ("Focusing", "On break"...).
  status      String?
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, deskId])
  @@index([workspaceId])
}

// ============================================================================
// MIRA – auth, profile, invitations
// ============================================================================

/// One row per refresh token. Tokens are rotated on every use: the old row is
/// revoked and points to its replacement. All rows created from one sign-in
/// share a familyId (= one device), so a stolen token can kill the family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  familyId     String
  /// SHA-256 of the token. The token itself is only ever in the cookie.
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// A Google / GitHub / 42 identity linked to a user.
model OAuthAccount {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  userId         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  /// "Close all my sessions" link, sent when the account is open on another device.
  CLOSE_SESSIONS
}

/// One-time tokens sent by email (verify email, reset password).
model AuthToken {
  id          String        @id @default(cuid())
  userId      String
  type        AuthTokenType
  tokenHash   String        @unique
  /// SHA-256 of a secret cookie of the browser that asked for the link. The
  /// link only works in that browser (or elsewhere with the account password).
  bindingHash String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Authenticator-app (TOTP) settings. enabledAt is null until the user has
/// confirmed the first code, so a half-finished setup never locks anyone out.
model TwoFactor {
  userId         String    @id
  /// AES-256-GCM encrypted base32 secret.
  secret         String
  enabledAt      DateTime?
  /// SHA-256 hashes of the unused backup codes.
  backupCodes    String[]
  /// Last accepted 30-second step, so a code can't be used twice.
  lastUsedStep   Int?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

/// An emailed invitation to join a workspace. Only works for that email address.
model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        Role             @default(MEMBER)
  /// SHA-256 of the token in the link.
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  answeredAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
}

// ============================================================================
// ROY – onboarding, office map, game
// ============================================================================

// ============================================================================
// ZAKARIA (+ helper) – tasks, voice, meeting room, chill room
// ============================================================================

/// How someone talks in the office: mic open (with a mute button) or push to talk.
enum VoiceMode {
  OPEN
  PUSH_TO_TALK
}

/// Personal settings, the same on every device.
model UserSettings {
  userId        String    @id
  voiceMode     VoiceMode @default(OPEN)
  /// KeyboardEvent.code held to talk in PUSH_TO_TALK mode ("KeyV", "Space"...).
  pushToTalkKey String    @default("KeyV")
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A text message: to the whole office (channel "office") or inside a room
/// (channel = the layout room id, seen only by people in that room).
model ChatMessage {
  id          String   @id @default(cuid())
  workspaceId String
  channel     String
  userId      String
  text        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, channel, createdAt])
}

/// A meeting room reserved for a time slot. No two bookings of one room overlap
/// (checked by the API under a lock). While it runs, only its attendees can enter
/// the room, hear its audio and read its chat.
model RoomBooking {
  id          String   @id @default(cuid())
  workspaceId String
  /// Meeting room id in the layout (rooms with kind "meeting").
  roomId      String
  title       String
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  /// Who may join (always includes the creator).
  attendeeIds String[]
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, roomId, startsAt])
}
