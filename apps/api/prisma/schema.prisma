// Single database schema for the whole project.
//
// Rules to avoid merge conflicts:
//   - Each person only edits the models inside their own section.
//   - Changes to the CORE section are discussed with the whole team first.
//   - After editing, run `make db` to push the schema and regenerate the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Core: users and workspaces =====

/// Registered user account with authentication credentials, profile info, and workspace relations.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  displayName     String
  avatarUrl       String?
  /// scrypt hash; null for accounts created with Google / GitHub / 42 only.
  passwordHash    String?
  /// Timestamp when email was confirmed; null for unverified accounts.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  oauthAccounts   OAuthAccount[]
  authTokens      AuthToken[]
  twoFactor       TwoFactor?
  membership      WorkspaceMember?
  invitationsSent Invitation[]
  settings        UserSettings?
  chatMessages    ChatMessage[]
  bookings        RoomBooking[]
  tasksReported   Task[]           @relation("TaskReporter")
  tasksAssigned   Task[]           @relation("TaskAssignee")
  wallet          Wallet?
  coinTxs         CoinTx[]
}

/// Organization and virtual office environment containing layout, rooms, and shared resources.
model Workspace {
  id            String   @id @default(cuid())
  name          String
  /// Template the office started from (studio, loft, campus...).
  templateId    String
  /// The office: rooms, walls, furniture (see apps/api/src/office/layout/types.ts).
  layout        Json
  /// Bumped on every save, so two editors can't overwrite each other.
  layoutVersion Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members      WorkspaceMember[]
  invitations  Invitation[]
  chatMessages ChatMessage[]
  bookings     RoomBooking[]
  tasks        Task[]
  wings        OfficeWing[]
  gameResults  GameResult[]
  legoBoards   LegoBoard[]
  whiteboards  Whiteboard[]
  coinTxs      CoinTx[]
}

/// Workspace permission role determining administrative, invitation, and office editing privileges.
enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// A person in a workspace, tracking their role, desk assignment, status, and avatar appearance.
model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String   @unique
  workspaceId String
  role        Role     @default(MEMBER)
  /// Character: a named preset ("maya", "sam"...) or a recipe code: "1" + one
  /// base-36 digit per choice (body, hair, outfit, desk vibe...), 19 characters.
  /// Format and validation: apps/web/game/art/recipe.ts, apps/api/src/workspace/characters.ts.
  character   String   @default("maya")
  /// Their desk: a desk furniture id of the layout (null when every desk is taken).
  deskId      String?
  /// Short status shown above the avatar ("Focusing", "On break"...).
  status      String?
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, deskId])
  @@index([workspaceId])
}

/// Lifecycle status of an email invitation sent to join a workspace.
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

/// Emailed invitation to join a workspace with a hashed token and expiration timestamp.
model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        Role             @default(MEMBER)
  /// SHA-256 of the token in the link.
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  answeredAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
}

// ===== Auth: sessions, refresh tokens, email tokens, OAuth accounts, 2FA =====

/// Rotating session refresh token bound to a device token family for replay detection.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// Device session identifier shared across rotated tokens in the same chain.
  familyId     String
  /// SHA-256 of the token. The token itself is only ever in the cookie.
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Points to the replacement token ID when rotated.
  replacedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// External OAuth provider identity (Google, GitHub, 42) linked to a user account.
model OAuthAccount {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  userId         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// Purpose of a one-time emailed authentication token (email verification, password reset, session revoke).
enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  /// "Close all my sessions" link, sent when the account is open on another device.
  CLOSE_SESSIONS
}

/// One-time hashed email token for password reset, email verification, or session revocation.
model AuthToken {
  id          String        @id @default(cuid())
  userId      String
  type        AuthTokenType
  tokenHash   String        @unique
  /// SHA-256 of a secret cookie of the browser that asked for the link. The
  /// link only works in that browser (or elsewhere with the account password).
  bindingHash String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// TOTP two-factor authentication configuration, encrypted secret, and backup codes for a user.
model TwoFactor {
  userId         String    @id
  /// AES-256-GCM encrypted base32 secret.
  secret         String
  /// Timestamp when 2FA was confirmed; null while setup is incomplete.
  enabledAt      DateTime?
  /// SHA-256 hashes of the unused backup codes.
  backupCodes    String[]
  /// Last accepted 30-second step, so a code can't be used twice.
  lastUsedStep   Int?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===== Office: desks, layout, office state =====

/// Directional side of the office building where an expansion wing attaches.
enum WingSide {
  LEFT
  RIGHT
  BOTTOM
}

/// Procedural extension wing attached to an office layout to expand desk capacity.
model OfficeWing {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  side        WingSide
  /// Random seed used for procedural wing generation.
  seed        String
  /// Left tile position in office layout coordinates.
  x           Float
  /// Top tile position in office layout coordinates.
  y           Float
  /// Wing width in tiles.
  w           Float
  /// Wing height in tiles.
  h           Float
  /// Number of additional desks provided by this wing.
  deskCount   Int
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// ===== Tasks =====

/// Issue classification type on the workspace task board (task, bug, or story).
enum TaskType {
  TASK
  BUG
  STORY
}

/// Workflow progression column status for tasks on the workspace board.
enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

/// Urgency and severity priority level assigned to a task.
enum TaskPriority {
  HIGHEST
  HIGH
  MEDIUM
  LOW
  LOWEST
}

/// Issue tracker task within a workspace board, identified by sequential number and ranked in status columns.
model Task {
  id          String       @id @default(cuid())
  workspaceId String
  /// Sequential per workspace (1, 2, 3...), never reused.
  number      Int
  type        TaskType     @default(TASK)
  title       String
  description String       @default("")
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  /// A member of the workspace; cleared when they leave.
  assigneeId  String?
  reporterId  String
  dueDate     DateTime?
  /// Order inside a status column (lower = higher up).
  rank        Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reporter  User      @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, number])
  @@index([workspaceId, status, rank])
  @@index([workspaceId, assigneeId])
}

// ===== Meetings & chat =====

/// Voice audio transmission mode for office proximity chat (open microphone or push-to-talk).
enum VoiceMode {
  OPEN
  PUSH_TO_TALK
}

/// User preferences for voice chat transmission and keyboard shortcuts across devices.
model UserSettings {
  userId        String    @id
  voiceMode     VoiceMode @default(OPEN)
  /// KeyboardEvent.code held to talk in PUSH_TO_TALK mode ("KeyV", "Space"...).
  pushToTalkKey String    @default("KeyV")
  /// Rebound keys by action (KeyboardEvent.code). Missing actions use the defaults.
  keybinds      Json      @default("{}")
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Text chat message sent to an office channel or a scoped room booking.
model ChatMessage {
  id          String   @id @default(cuid())
  workspaceId String
  /// Channel identifier ("office" for workspace-wide, or room ID for room-scoped chat).
  channel     String
  userId      String
  text        String
  /// The booking running in the room when it was sent: a meeting's chat stays
  /// with that meeting (null = outside any booking).
  bookingId   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, channel, createdAt])
}

/// Scheduled meeting room reservation controlling attendee access, audio privacy, and room chat.
model RoomBooking {
  id          String   @id @default(cuid())
  workspaceId String
  /// Meeting room id in the layout (rooms with kind "meeting").
  roomId      String
  title       String
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  /// Who may join (always includes the creator).
  attendeeIds String[]
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, roomId, startsAt])
}

// ===== Games =====

/// Outcome of a completed minigame match recording winners and losers for workspace leaderboards.
model GameResult {
  id          String   @id @default(cuid())
  workspaceId String
  game        String
  winners     String[]
  losers      String[]
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, game, createdAt])
}

/// Collaborative virtual lego building board storing brick state as JSON for debounced persistence.
model LegoBoard {
  id          String   @id @default(cuid())
  workspaceId String
  /// Furniture object ID in the office layout corresponding to the board.
  objectId    String
  /// JSON array of placed bricks [x, y, colorIndex, shapeIndex, rotation].
  bricks      Json
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, objectId])
}

/// Shared whiteboard of a meeting room: the Excalidraw scene drawn there.
model Whiteboard {
  id          String   @id @default(cuid())
  workspaceId String
  /// Meeting room ID in the office layout.
  roomId      String
  /// JSON array of Excalidraw elements (deleted ones are not stored).
  elements    Json
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, roomId])
}

/// A member's wallet on the office blockchain (PulseCoin, spent in the kitchen). The app keeps the key
/// (custodial): members never need a crypto wallet of their own, nor gas.
model Wallet {
  userId       String   @id
  address      String   @unique
  /// Private key, AES-256-GCM encrypted with a key derived from JWT_SECRET (like 2FA secrets).
  encryptedKey String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Why coins moved: rewards (welcome, daily allowance, task done, game won, admin grant) or a kitchen purchase.
enum CoinTxKind {
  WELCOME
  DAILY
  TASK
  GAME
  GRANT
  PURCHASE
}

/// A PulseCoin transaction made by the app, with its on-chain proof. Balances are read from the chain;
/// this is the history and the office ledger.
model CoinTx {
  id          String     @id @default(cuid())
  workspaceId String
  /// Whose wallet received or paid.
  userId      String
  kind        CoinTxKind
  /// Whole coins: positive received, negative spent.
  amount      Int
  /// Kitchen item bought ("water", "pepsi", "dinner").
  item        String?
  /// Grants: who gave the coins, and their note.
  byUserId    String?
  note        String?
  /// Makes each reward happen once ("welcome:<user>", "task:<task>", "game:<result>:<user>").
  rewardKey   String?    @unique
  txHash      String     @unique
  blockNumber Int
  chainId     Int
  createdAt   DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

/// Where the contracts live on each chain (deployed by the API on first start).
model ChainDeployment {
  chainId     Int      @id
  coinAddress String
  shopAddress String
  deployedAt  DateTime @default(now())
}
