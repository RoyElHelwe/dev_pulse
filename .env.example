# Copy to .env (`make` does it for you) and change the secrets.
# .env is git-ignored – never commit it.

# ---- Access -----------------------------------------------------------------
# Open the app at https://SERVER_NAME:HTTPS_PORT
# Use your LAN IP (e.g. 10.12.1.5) to let teammates join from other machines.
SERVER_NAME=localhost
HTTPS_PORT=8443

# ---- Database ---------------------------------------------------------------
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devpulse

# ---- Auth (Mira) ------------------------------------------------------------
# Signs the access tokens. At least 32 random characters; `make` generates one.
# Generate by hand with: openssl rand -base64 48
JWT_SECRET=change-me
