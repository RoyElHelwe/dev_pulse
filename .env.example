# Copy to .env (`make` does it for you) and change the secrets.
# .env is git-ignored – never commit it.

# ---- Access -----------------------------------------------------------------
# Open the app at https://SERVER_NAME:HTTPS_PORT
# Use your LAN IP (e.g. 10.12.1.5) to let teammates join from other machines.
SERVER_NAME=localhost
HTTPS_PORT=8443

# ---- Database ---------------------------------------------------------------
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devpulse

# ---- Auth (Mira) ------------------------------------------------------------
# Signs the access tokens. At least 32 random characters; `make` generates one.
# Generate by hand with: openssl rand -base64 48
JWT_SECRET=change-me

# Block sign-in until the email link is clicked. Turn on once SMTP works.
REQUIRE_EMAIL_VERIFICATION=false

# ---- Email (optional) ---------------------------------------------------------
# Without SMTP_HOST, emails (and their links) are printed in `make logs s=api`.
# Resend works too: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=resend, SMTP_PASS=<your re_... API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Dev Pulse <no-reply@devpulse.local>

# ---- Sign in with Google / GitHub / 42 (optional) -----------------------------
# A button appears only when both values are set. Register this callback URL
# in each provider's settings (with your SERVER_NAME and HTTPS_PORT):
#   https://localhost:8443/api/auth/oauth/<google|github|42>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=

# ---- Dev identity switcher ------------------------------------------------------
# true = /login shows a one-click 'sign in as any user' switcher (no password, no 2FA).
# LOCAL TESTING ONLY. NEVER enable this on a server anyone else can reach. Ignored when NODE_ENV=production.
DEV_LOGIN=false
