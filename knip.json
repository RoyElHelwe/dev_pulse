{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "ignoreBinaries": ["prisma", "typecheck", "build"],
  "tags": ["-public"],
  "workspaces": {
    ".": {
      "entry": ["tools/art-lab/entry.ts"],
      "project": ["tools/art-lab/**/*.ts"],
      "ignoreDependencies": ["phaser"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/**/*.spec.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "app/**/{page,layout,loading,error,not-found,route,template,default}.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "e2e": {
      "entry": ["tests/**/*.spec.ts"],
      "project": ["**/*.ts"]
    }
  }
}
